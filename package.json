{
  "name": "skati-erp-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "./start.sh",
    "start:live": "./start.sh live",
    "start:local": "./start.sh local",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "firebase:emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "firebase:emulators:export": "firebase emulators:export ./emulator-data",
    "firebase:emulators:import": "firebase emulators:start --import=./emulator-data",
    "seed:db": "node scratch/provision-live-database.mjs",
    "seed:auth": "node scratch/seed-live-auth.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@rolldown/binding-linux-x64-gnu": "^1.2.13",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "firebase-tools": "^15.32.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
